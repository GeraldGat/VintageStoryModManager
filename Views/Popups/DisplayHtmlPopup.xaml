<Window x:Class="VintageStoryModManager.Views.Popups.DisplayHtmlPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Detail"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource PopupWindowStyle}"
        Width="600"
        Height="600">
    <Border Style="{StaticResource PopupWindowBorderStyleWithActionBar}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <DockPanel Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Style="{StaticResource BaseWindowControlButtonsStyle}">
                <DockPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Click="Minimize_Click">
                        <iconPacks:PackIconLucide Kind="Minus"/>
                    </Button>
                    <Button Click="Maximize_Click">
                        <iconPacks:PackIconLucide Kind="Square"/>
                    </Button>
                    <Button Click="Close_Click">
                        <iconPacks:PackIconLucide Kind="X"/>
                    </Button>
                </DockPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
                <wv2:WebView2 Name="HtmlViewer"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
