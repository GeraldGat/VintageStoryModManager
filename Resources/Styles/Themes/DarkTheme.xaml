<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ForegroundColor" Color="#E0E0E0"/>
    
    <SolidColorBrush x:Key="WindowBackgroundColor" Color="#1E1E2F"/>
    <SolidColorBrush x:Key="WindowBorderColor" Color="#333"/>
    <SolidColorBrush x:Key="WindowControlButtonColor" Color="White"/>
    <SolidColorBrush x:Key="WindowControlButtonHoverColor" Color="#4000"/>

    <SolidColorBrush x:Key="MenuItemBackgroundHoverColor" Color="#4000"/>
    <SolidColorBrush x:Key="MenuItemBackgroundSelectedColor" Color="#4FFF"/>
    <SolidColorBrush x:Key="MenuForegoundColor" Color="White"/>
    
</ResourceDictionary>