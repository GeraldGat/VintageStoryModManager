<Window x:Class="VintageStoryModManager.Views.Popups.CreateModpackPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Create modpack"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource PopupWindowStyle}">
    <Border Style="{StaticResource PopupWindowBorderStyle}">
        <StackPanel>
            <TextBlock Text="Create Modpack" Style="{StaticResource PopupTitleStyle}"/>

            <TextBlock Text="Name"/>
            <TextBox Text="{Binding ModpackName, Mode=TwoWay}"
                     Margin="0,5,0,5"
                     Width="Auto"/>

            <TextBlock Text="Version"/>
            <ComboBox ItemsSource="{Binding InstalledVersions.Values}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      Margin="0,5,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" 
                        Command="{Binding CancelCommand}"
                        Margin="0,0,10,0"/>
                <Button Content="Create"
                        Command="{Binding CreateCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>