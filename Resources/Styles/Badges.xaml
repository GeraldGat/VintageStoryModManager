<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">  

   <Style x:Key="Badge" TargetType="Border">  
       <Setter Property="Background" Value="#AA000000"/>  
       <Setter Property="CornerRadius" Value="4"/>  
       <Setter Property="Padding" Value="10,5,10,5"/>  
       <Setter Property="HorizontalAlignment" Value="Left"/>  
       <Setter Property="VerticalAlignment" Value="Top"/>  
       <Setter Property="Margin" Value="5"/>  
   </Style>  

   <Style x:Key="IconBadge" TargetType="Border" BasedOn="{StaticResource Badge}">  
       <Style.Resources>  
           <Style TargetType="StackPanel">  
               <Setter Property="Orientation" Value="Horizontal"/>  
               <Setter Property="VerticalAlignment" Value="Center"/>  
               <Style.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontFamily" Value="Roboto"/>
                        <Setter Property="Margin" Value="0,0,5,0"/>  
                   </Style>
                    <Style TargetType="iconPacks:PackIconLucide" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
                        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                        <Setter Property="Width" Value="12"/>  
                        <Setter Property="Height" Value="12"/>  
                        <Setter Property="VerticalAlignment" Value="Center"/>  
                   </Style>  
               </Style.Resources>  
           </Style>  
       </Style.Resources>  
   </Style>  
</ResourceDictionary>