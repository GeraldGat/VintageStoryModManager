<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFFAF5"/>
    <SolidColorBrush x:Key="ForegroundColor" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AccentColor" Color="#2F6FED"/>

    <SolidColorBrush x:Key="WindowBackgroundColor" Color="#FFE4C7"/>
    <SolidColorBrush x:Key="WindowBorderColor" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="WindowControlButtonColor" Color="#333333"/>
    <SolidColorBrush x:Key="WindowControlButtonHoverColor" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="MenuItemBackgroundHoverColor" Color="#E6F0FF"/>
    <SolidColorBrush x:Key="MenuItemBackgroundSelectedColor" Color="#D6E4FF"/>
    <SolidColorBrush x:Key="MenuForegoundColor" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MenuForegoundDisabledColor" Color="#4D1A1A1A"/>

    <SolidColorBrush x:Key="BorderColor" Color="#DADADA"/>
    <SolidColorBrush x:Key="HoverColor" Color="#E9EEF7"/>
    <SolidColorBrush x:Key="SelectedColor" Color="#C3D4FD"/>

    <SolidColorBrush x:Key="ButtonBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#D9D9D9"/>

    <SolidColorBrush x:Key="CardBackgroundColor" Color="#F0F0F0"/>
    
</ResourceDictionary>