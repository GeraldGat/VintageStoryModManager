<Window x:Class="VintageStoryModManager.Views.Popups.InstallModPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Install Mod"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource PopupWindowStyle}"
        Width="600"
        Height="600">
    <Border Style="{StaticResource PopupWindowBorderStyleWithActionBar}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Style="{StaticResource BaseWindowControlButtonsStyle}">
                <DockPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Click="Minimize_Click">
                        <iconPacks:PackIconLucide Kind="Minus"/>
                    </Button>
                    <Button Click="Maximize_Click">
                        <iconPacks:PackIconLucide Kind="Square"/>
                    </Button>
                    <Button Click="Close_Click">
                        <iconPacks:PackIconLucide Kind="X"/>
                    </Button>
                </DockPanel>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="{Binding InstalledVersion, StringFormat='Installed version: {0}'}" Margin="5" Visibility="{Binding InstalledVersion, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>

            <DataGrid x:Name="ReleaseDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"https://www.dropbox.com/scl/fo/hu7gbljjng1dy7l89ppln/ANVNVYWVuux8eL3bVqgyBYI/betterruins.png?rlkey=y8pk6enrg1foqzvrhw24v51wb&raw=1
                      CanUserAddRows="False"
                      Grid.Row="2"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ItemsSource="{Binding Releases}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Version" Binding="{Binding ModVersion}" Width="Auto"/>
                    <DataGridTemplateColumn Header="Game Version" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GameVersion}" 
                                           Foreground="{Binding ModCompatibility, 
                                                        Converter={StaticResource CompatibilityToForegroundConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Downloads" Binding="{Binding Downloads}" Width="Auto"/>
                    <DataGridTextColumn Header="Release date" Binding="{Binding Created}" Width="Auto"/>
                    <DataGridTemplateColumn Header="" Width="85" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Style="{StaticResource DataGridActions}">
                                    <Button Command="{Binding DataContext.ShowChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                             Visibility="{Binding Changelog, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                        <Button.Content>
                                            <iconPacks:PackIconLucide Kind="Logs"/>
                                        </Button.Content>
                                    </Button>
                                    <Button Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Content>
                                            <iconPacks:PackIconLucide Kind="Download"/>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
