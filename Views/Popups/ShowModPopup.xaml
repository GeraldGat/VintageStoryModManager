<Window x:Class="VintageStoryModManager.Views.Popups.ShowModPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Show Mod"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource PopupWindowStyle}"
        Width="600"
        Height="600">
    <Border Style="{StaticResource PopupWindowBorderStyleWithActionBar}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <DockPanel Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Style="{StaticResource BaseWindowControlButtonsStyle}">
                <DockPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Click="Minimize_Click">
                        <iconPacks:PackIconLucide Kind="Minus"/>
                    </Button>
                    <Button Click="Maximize_Click">
                        <iconPacks:PackIconLucide Kind="Square"/>
                    </Button>
                    <Button Click="Close_Click">
                        <iconPacks:PackIconLucide Kind="X"/>
                    </Button>
                </DockPanel>
            </DockPanel>
            
            <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding ModInfos.Name}" Style="{StaticResource Title}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding  ModInfos.Author, StringFormat='by {0}'}" FontStyle="Italic" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Command="{Binding OpenVsModUrlCommand}">
                                <Button.Content>
                                    <iconPacks:PackIconLucide Kind="Cog"/>
                                </Button.Content>
                            </Button>
                            <Button Command="{Binding OpenHomepageUrlCommand}" Visibility="{Binding ModInfos.HomepageUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                <Button.Content>
                                    <iconPacks:PackIconLucide Kind="House"/>
                                </Button.Content>
                            </Button>
                            <Button Command="{Binding OpenSourceCodeUrlCommand}" Visibility="{Binding ModInfos.SourceCodeUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                <Button.Content>
                                    <iconPacks:PackIconLucide Kind="GitBranch"/>
                                </Button.Content>
                            </Button>
                            <Button Command="{Binding OpenTrailerVideoUrlCommand}" Visibility="{Binding ModInfos.TrailerVideoUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                <Button.Content>
                                    <iconPacks:PackIconLucide Kind="MonitorPlay"/>
                                </Button.Content>
                            </Button>
                            <Button Command="{Binding OpenIssueTrackerUrlCommand}" Visibility="{Binding ModInfos.IssueTrackerUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                <Button.Content>
                                    <iconPacks:PackIconLucide Kind="Bug"/>
                                </Button.Content>
                            </Button>
                            <Button Command="{Binding OpenWikiUrlCommand}" Visibility="{Binding ModInfos.WikiUrl, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                <Button.Content>
                                    <iconPacks:PackIconLucide Kind="CircleHelp"/>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ModInfos.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource IconBadge}" Background="#AAC7E1AE">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StringFormat='#{0}'}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2" Margin="0,10">
                        <Image Stretch="UniformToFill"
                               MaxWidth="550"
                               HorizontalAlignment="Center"
                               Source="{Binding ModInfos.LogoFile, 
                                Converter={StaticResource ImageUrlToBitmapConverter}, 
                                ConverterParameter='pack://application:,,,/Resources/Images/mod-default.png'}"/>
                        
                        <Border Style="{StaticResource IconBadge}">
                            <StackPanel>
                                <TextBlock Text="{Binding ModInfos.Follows}" Foreground="#E4E4E4"/>
                                <iconPacks:PackIconLucide Kind="ThumbsUp" Foreground="#E4E4E4"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Right">
                            <StackPanel>
                                <TextBlock Text="{Binding ModInfos.Downloads}" Foreground="#E4E4E4"/>
                                <iconPacks:PackIconLucide Kind="Download" Foreground="#E4E4E4"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Vertical">
                        <TextBlock>
                            <Run Text="Side :" FontWeight="Bold"/>
                            <Run Text="{Binding ModInfos.Side}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Created At :" FontWeight="Bold"/>
                            <Run Text="{Binding ModInfos.Created}"/>
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Last Released :" FontWeight="Bold"/>
                            <Run Text="{Binding ModInfos.LastReleased}"/>
                        </TextBlock>
                    </StackPanel>

                    <wv2:WebView2 Grid.Row="4" Name="HtmlViewer"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
